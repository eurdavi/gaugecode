{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GaugeCode",
  "version": "0.1.5",
  "identifier": "com.eurdavi.gaugecode",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "notch",
        "title": "GaugeCode notch",
        "url": "notch.html",
        "width": 10,
        "height": 80,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "shadow": false
      },
      {
        "label": "bar",
        "title": "GaugeCode bar",
        "url": "bar.html",
        "width": 152,
        "height": 48,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "shadow": false
      },
      {
        "label": "popup",
        "title": "GaugeCode",
        "url": "popup.html",
        "width": 340,
        "height": 420,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true
      },
      {
        "label": "settings",
        "title": "GaugeCode — Settings",
        "url": "settings.html",
        "width": 460,
        "height": 480,
        "minWidth": 400,
        "minHeight": 360,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost https://ipc.localhost",
        "img-src": "'self' data:",
        "style-src": "'unsafe-inline' 'self'",
        "object-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self' http://localhost:1420",
        "connect-src": "ipc: http://ipc.localhost https://ipc.localhost http://localhost:1420 ws://localhost:1420",
        "img-src": "'self' data:",
        "style-src": "'unsafe-inline' 'self'",
        "script-src": "'unsafe-inline' 'unsafe-eval' 'self'"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/eurdavi/gaugecode/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM1ODMxMzUzMkVBQTY4MUMKUldRY2FLb3VVeE9EeFhZOWMzaEZpSmdCdG9NQlJCQ2FsNUVLVnVkRFQvbXRTRmt1UXdoTW91VnMK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
