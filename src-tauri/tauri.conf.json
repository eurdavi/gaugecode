{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GaugeCode",
  "version": "0.1.0",
  "identifier": "com.eurdavi.gaugecode",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "settings",
        "title": "GaugeCode — Settings",
        "url": "settings.html",
        "width": 480,
        "height": 520,
        "minWidth": 400,
        "minHeight": 360,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
