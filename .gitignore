# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Never commit real credentials or unsanitized responses
*.credentials.json
auth.json
state.vscdb

# Internal working documents, kept at the root because the agent rules and the
# spec reference each other from here — but not published. README.md is the
# public face of the project and stays tracked.
AGENTS.md
SPEC.md

# Updater signing key, if one is ever generated beside the project
*.key
!src-tauri/**/*.key

# Locally built installers, copied here so they are easy to find
installers/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
